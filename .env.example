# =============================================================================
# Simpsons Quote Search Engine - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Simpsons Quote Search Engine
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
# PostgreSQL with pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=simpsons
POSTGRES_PASSWORD=simpsons123
POSTGRES_DB=simpsons_db

# Full connection string (used by app)
DATABASE_URL=postgresql://simpsons:simpsons123@localhost:5432/simpsons_db

# -----------------------------------------------------------------------------
# Redis Settings
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
CACHE_TTL_SEARCH=3600
CACHE_TTL_EMBEDDINGS=86400

# -----------------------------------------------------------------------------
# AI/ML Settings
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Retrieval Settings
BM25_WEIGHT=0.5
SEMANTIC_WEIGHT=0.5
RRF_K=60
DEFAULT_TOP_K=5

# -----------------------------------------------------------------------------
# MLflow Settings
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=simpsons-search
MLFLOW_ARTIFACT_LOCATION=./mlruns

# -----------------------------------------------------------------------------
# Observability Settings
# -----------------------------------------------------------------------------
# OpenTelemetry
OTEL_SERVICE_NAME=simpsons-quote-search
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus

# Prometheus
PROMETHEUS_PORT=9090
METRICS_PATH=/metrics

# Jaeger
JAEGER_HOST=localhost
JAEGER_UI_PORT=16686

# Grafana
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# API Keys (for external clients)
# API_KEY_HEADER=X-API-Key
# API_KEYS=["key1","key2"]

# -----------------------------------------------------------------------------
# Data Settings
# -----------------------------------------------------------------------------
DATA_DIR=./data
PROCESSED_DATA_DIR=./data/processed
INDEX_DIR=./data/indices

# HuggingFace Dataset
HF_DATASET_NAME=jayantdocplix/simpsons-script-lines
HF_MAX_SAMPLES=50000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_CACHE=true
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_MLFLOW=false

# -----------------------------------------------------------------------------
# Docker Settings
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=simpsons-search
